# DTE Diagnostic Agent Environment Variables
# Copy this file to .env and fill in your actual values

# LLM Configuration
# API key for the LLM service (e.g., OpenAI, Alibaba Cloud Dashscope)
LLM_API_KEY=your-api-key-here

# Authentication
# API key for accessing the diagnostic agent API
DTE_DIAG_API_KEY=your-api-key-here